    private val statusState =
        mutableStateOf("Preparando motor dlib offline...")
    private val personState = mutableStateOf("Sin resultado")
    private val distanceState = mutableStateOf("â€”")

    private var previewView: PreviewView? = null
    private var cameraProvider: ProcessCameraProvider? = null
    private var imageCapture: ImageCapture? = null
    private var recognizer: DlibOfflineRecognizer? = null

    private val captureExecutor: ExecutorService =
