                        Spacer(modifier = Modifier.height(2.dp))
                    }
                }
            }
        }
    }

    private fun initializeRecognition() {
        try {
            recognizer = DlibOfflineRecognizer(applicationContext)
            statusState.value =
                NativeFaceBridge.nativeStatus() +
                    ". Abre la cÃ¡mara y toma una foto para analizarla."
        } catch (error: UnsatisfiedLinkError) {
            statusState.value =
                "No se pudo cargar libnexusface.so. Revisa la compilaciÃ³n CMake."
        } catch (error: Exception) {
            statusState.value =
                "No se pudo iniciar el motor: " +
                    (error.message ?: error.javaClass.simpleName)
        }
    }

    private fun startCamera() {
        val preview = previewView
        if (preview == null) {
            statusState.value =
                "La vista de cÃ¡mara todavÃ­a no estÃ¡ preparada."
            return
        }

        statusState.value = "Iniciando cÃ¡mara..."

        val future = ProcessCameraProvider.getInstance(this)
        future.addListener({
            try {
                val provider = future.get()
                cameraProvider = provider

                val rotation = preview.display?.rotation ?: Surface.ROTATION_0

                val cameraPreview = Preview.Builder()
                    .build()
                    .also {
                        it.setSurfaceProvider(preview.surfaceProvider)
                    }

                val capture = ImageCapture.Builder()
                    .setCaptureMode(ImageCapture.CAPTURE_MODE_MINIMIZE_LATENCY)
                    .setTargetRotation(rotation)
                    .build()

                provider.unbindAll()
                provider.bindToLifecycle(
                    this,
                    CameraSelector.DEFAULT_FRONT_CAMERA,
                    cameraPreview,
                    capture
                )

                imageCapture = capture
                statusState.value =
                    "CÃ¡mara activa. Centra el rostro, busca buena luz y pulsa Tomar foto."
            } catch (error: Exception) {
                statusState.value =
                    "No se pudo iniciar la cÃ¡mara: " +
                        (error.message ?: "Error desconocido")
            }
        }, ContextCompat.getMainExecutor(this))
    }

    private fun takePhotoAndRecognize() {
        val capture = imageCapture
        val engine = recognizer

        if (capture == null) {
            statusState.value = "Primero pulsa Abrir cÃ¡mara."
            return
        }
        if (engine == null) {
            statusState.value = "El motor dlib no estÃ¡ disponible."
            return
        }

        personState.value = "Analizando..."
        distanceState.value = "â€”"
        statusState.value =
            "Capturando y analizando localmente. La primera ejecuciÃ³n puede tardar."

        val photoFile = File(
            cacheDir,
            "nexus_capture_${System.currentTimeMillis()}.jpg"
        )
        val outputOptions = ImageCapture.OutputFileOptions.Builder(photoFile).build()

        capture.takePicture(
            outputOptions,
            captureExecutor,
            object : ImageCapture.OnImageSavedCallback {
                override fun onImageSaved(
                    outputFileResults: ImageCapture.OutputFileResults
                ) {
                    var bitmap: Bitmap? = null
                    var orientedBitmap: Bitmap? = null

                    try {
                        bitmap = BitmapFactory.decodeFile(photoFile.absolutePath)
                            ?: error("No se pudo leer la foto capturada.")

                        val orientation = ExifInterface(photoFile).getAttributeInt(
                            ExifInterface.TAG_ORIENTATION,
                            ExifInterface.ORIENTATION_NORMAL
                        )
                        orientedBitmap = applyExifOrientation(bitmap, orientation)

                        val sourceBitmap = orientedBitmap
                            ?: error("No se pudo orientar la fotografia.")

                        // Reducir la imagen para limitar el consumo de memoria.
                        val largestSide = maxOf(sourceBitmap.width, sourceBitmap.height)
                        val analysisBitmap = if (largestSide > 960) {
                            val scale = 960f / largestSide.toFloat()
                            Bitmap.createScaledBitmap(
                                sourceBitmap,
                                (sourceBitmap.width * scale).toInt().coerceAtLeast(1),
                                (sourceBitmap.height * scale).toInt().coerceAtLeast(1),
                                true
                            )
                        } else {
                            sourceBitmap
                        }

                        android.util.Log.i(
                            "NEXUS_FACE",
                            "Inicio dlib: ${analysisBitmap.width}x${analysisBitmap.height}"
                        )

                        val result = try {
                            engine.recognize(analysisBitmap)
                        } finally {
                            if (analysisBitmap !== sourceBitmap) {
                                analysisBitmap.recycle()
                            }
                        }

                        android.util.Log.i(
                            "NEXUS_FACE",
                            "Fin dlib: ${result.message}"
                        )

                        runOnUiThread {
                            personState.value =
                                if (result.accepted) {
                                    result.personName ?: "Desconocido"
                                } else {
                                    "Desconocido"
                                }

                            distanceState.value = result.distance?.let {
                                String.format(Locale.US, "%.3f", it)
                            } ?: "â€”"

                            statusState.value = result.message
                        }
                    } catch (error: UnsatisfiedLinkError) {
                        runOnUiThread {
                            statusState.value =
                                "No se pudo cargar el motor nativo: ${error.message}"
                        }
                    } catch (error: Exception) {
                        runOnUiThread {
                            statusState.value =
                                "Error de reconocimiento: " +
                                    (error.message ?: error.javaClass.simpleName)
                        }
                    } finally {
                        if (
                            orientedBitmap != null &&
                            orientedBitmap !== bitmap
                        ) {
                            orientedBitmap.recycle()
                        }
                        bitmap?.recycle()
                        photoFile.delete()
                    }
                }

                override fun onError(exception: ImageCaptureException) {
                    photoFile.delete()
                    runOnUiThread {
                        statusState.value =
                            "No se pudo tomar la foto: " +
                                (exception.message ?: "Error desconocido")
                    }
                }
            }
        )
    }

    private fun applyExifOrientation(bitmap: Bitmap, orientation: Int): Bitmap {
        val matrix = Matrix()
        when (orientation) {
            ExifInterface.ORIENTATION_ROTATE_90 -> matrix.postRotate(90f)
            ExifInterface.ORIENTATION_ROTATE_180 -> matrix.postRotate(180f)
            ExifInterface.ORIENTATION_ROTATE_270 -> matrix.postRotate(270f)
            ExifInterface.ORIENTATION_FLIP_HORIZONTAL -> matrix.preScale(-1f, 1f)
            ExifInterface.ORIENTATION_FLIP_VERTICAL -> matrix.preScale(1f, -1f)
            ExifInterface.ORIENTATION_TRANSPOSE -> {
                matrix.preScale(-1f, 1f)
                matrix.postRotate(90f)
            }
            ExifInterface.ORIENTATION_TRANSVERSE -> {
                matrix.preScale(-1f, 1f)
                matrix.postRotate(270f)
            }
            else -> return bitmap
        }

        return Bitmap.createBitmap(
            bitmap,
            0,
            0,
            bitmap.width,
            bitmap.height,
            matrix,
            true
        )
    }

    private fun stopCamera() {
        cameraProvider?.unbindAll()
        imageCapture = null
        statusState.value = "CÃ¡mara detenida."
    }

    override fun onDestroy() {
        cameraProvider?.unbindAll()
        captureExecutor.shutdownNow()
        super.onDestroy()
    }
}
